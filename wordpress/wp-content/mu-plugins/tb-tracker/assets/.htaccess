# Allow public assets (tb.js / admin CSS). Parent mu-plugins/.htaccess denies all.
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
  Allow from all
</IfModule>
